      "parameters": {
        "jsCode": "// Get input data\nlet data = $input.first().json;\n\n// Case 1: Unstract full API response\nif (data.message && data.message.result) {\n  data = data.message.result[0].result.output;\n}\n\n// Case 2: Array response\nif (Array.isArray(data)) {\n  data = data[0];\n}\n\n// Flatten line items if wrapped\nif (data.items_table?.line_items) {\n  data.line_items = data.items_table.line_items;\n  delete data.items_table;\n}\n\n// Ensure numeric values\ndata.subtotal = Number(data.subtotal);\ndata.cgst = Number(data.cgst);\ndata.sgst = Number(data.sgst);\ndata.tax_total = Number(data.tax_total);\ndata.total_amount = Number(data.total_amount);\n\n// Normalize line items\ndata.line_items = (data.line_items || []).map(item => ({\n  item_number: Number(item.item_number),\n  description: item.description,\n  hsn_sac: String(item.hsn_sac),\n  quantity: Number(item.quantity),\n  unit: item.unit,\n  unit_price: Number(item.unit_price),\n  amount: Number(item.amount)\n}));\n\nreturn [{ json: data }];"
      },
