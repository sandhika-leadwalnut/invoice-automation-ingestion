    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst binary = item.binary || {};\nconst count = Object.keys(binary).length;\n\nreturn [{\n  json: {\n    metrics_type: \"invoice_email_metrics\",\n    total_invoices_received: count\n  },\n  binary: binary\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        96,
        176
      ],
      "id": "65698f29-cd2b-4bc1-b0d5-87899a6427e5",
      "name": "Count Function"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst output = [];\n\nfor (const item of items) {\n  if (!item.binary) continue;\n\n  for (const key of Object.keys(item.binary)) {\n    output.push({\n      json: item.json,\n      binary: {\n        data: item.binary[key]\n      }\n    });\n  }\n}\n\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        112,
        384
      ],
      "id": "af7d9c1c-3d00-402b-a17c-8fc34d20d534",
      "name": "Iterate into batches"
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  if (!item.binary) return item;\n\n  const newBinary = {};\n\n  for (const key of Object.keys(item.binary)) {\n    const file = item.binary[key];\n\n    if (file.mimeType === 'application/pdf') {\n      newBinary[key] = file;\n    }\n  }\n\n  item.binary = newBinary;\n  return item;\n});"
      },
